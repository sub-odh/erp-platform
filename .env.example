NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=erp_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=replace-with-another-32-character-secret
JWT_REFRESH_TTL_SECONDS=2592000

LICENSE_PATH=license.json
LICENSE_PUBLIC_KEY_PATH=license-public.pem

# disabled, log, or smtp
EMAIL_DELIVERY_MODE=smtp
# Protects per-company SMTP passwords at rest. Use a unique production secret.
SMTP_CREDENTIAL_ENCRYPTION_KEY=development-only-smtp-encryption-key-change-me
